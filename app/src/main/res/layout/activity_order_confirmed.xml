<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".OrderConfirmedActivity">

    <ImageView
        android:id="@+id/success_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="64dp"
        android:src="@drawable/ic_success_checkmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/booking_confirmed_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Booking Confirmed!"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/success_icon" />

    <TextView
        android:id="@+id/booking_confirmed_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your booking has been placed successfully"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/booking_confirmed_title" />

    <androidx.cardview.widget.CardView
        android:id="@+id/booking_details_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/booking_confirmed_subtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking ID"
                android:textColor="@android:color/darker_gray" />

            <TextView
                android:id="@+id/booking_id_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BKG1766673233081"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2">

                <TextView
                    android:layout_columnWeight="1"
                    android:text="Equipment" />

                <TextView
                    android:id="@+id/equipment_text"
                    android:gravity="end"
                    android:text="Wedding Tent" />

                <TextView
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:text="Duration" />

                <TextView
                    android:id="@+id/duration_text"
                    android:gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="1 day(s)" />

                <TextView
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:text="Start Date" />

                <TextView
                    android:id="@+id/start_date_text"
                    android:gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="25/12/2025" />

                <TextView
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:text="Amount Paid" />

                <TextView
                    android:id="@+id/amount_paid_text"
                    android:gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="₹700" />

                <TextView
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:text="Status" />

                <TextView
                    android:id="@+id/status_text"
                    android:gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="REQUESTED"
                    android:textColor="#FFC107" />
            </GridLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/download_receipt_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_background"
        android:text="Download Receipt"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@+id/track_booking_button" />

    <Button
        android:id="@+id/track_booking_button"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:text="Track Booking"
        app:layout_constraintBottom_toTopOf="@+id/back_to_home_button" />

    <TextView
        android:id="@+id/back_to_home_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Back to Home"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
