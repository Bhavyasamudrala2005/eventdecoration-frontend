<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET permission -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventDecorationitems"
        android:usesCleartextTraffic="true">

        <!-- Launcher Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- User Activities -->
        <activity android:name=".LoginActivity"/>
        <activity android:name=".SignupActivity"/>
        <activity android:name=".ForgotPasswordActivity"/>
        <activity android:name=".UserDashboardActivity"/>
        <activity android:name=".UserProfileActivity"/>
        <activity android:name=".EditProfileActivity"/>
        <activity android:name=".OrderHistoryActivity"/>
        <activity android:name=".WishlistActivity"/>
        <activity android:name=".SettingsActivity"/>
        <activity android:name=".ResetLinkSentActivity"/>


        <!-- Admin Activities -->
        <activity android:name=".AdminLoginActivity"/>
        <activity android:name=".AdminDashboardActivity"/>
        <activity android:name=".AdminViewEquipmentActivity"/>
        <activity android:name=".BookingRequestsActivity"/>

        <!-- Equipment & Booking Activities -->
        <activity android:name=".AddEquipmentActivity"/>
        <activity android:name=".ViewEquipmentActivity"/>
        <activity android:name=".UpdateEquipmentActivity"/>
        <activity android:name=".BookingActivity"/>
        <activity android:name=".BookingDetailsActivity"/>
        <activity android:name=".BookingConfirmationActivity"/>
        <activity android:name=".ProceedToBookingActivity"/>
        <activity android:name=".FinalBookingActivity"/>
        <activity android:name=".TrackBookingActivity"/>
        <activity android:name=".PaymentActivity"/>
        <activity android:name=".OrderConfirmedActivity"/>
        <activity android:name=".CartActivity"/>
        <activity android:name=".BookingHistoryActivity"/>

        <!-- Items & Categories -->
        <activity android:name=".SpeakersActivity"/>
        <activity android:name=".BluetoothSpeakerActivity"/>
        <activity android:name=".StageSpeakerActivity"/>
        <activity android:name=".LargeEventSpeakersActivity"/>
        <activity android:name=".CarpetsActivity"/>
        <activity android:name=".EventCarpetActivity"/>
        <activity android:name=".MandapCarpetActivity"/>
        <activity android:name=".RedCarpetActivity"/>
        <activity android:name=".TentsActivity"/>
        <activity android:name=".WeddingTentActivity"/>
        <activity android:name=".CanopyTentActivity"/>
        <activity android:name=".SmallShadeTentActivity"/>
        <activity android:name=".CookingVesselsActivity"/>
        <activity android:name=".LargeCookingVesselsActivity"/>
        <activity android:name=".GasStovesActivity"/>
        <activity android:name=".ServingPotsActivity"/>
        <activity android:name=".PlasticChairsActivity"/>
        <activity android:name=".WeddingChairsActivity"/>
        <activity android:name=".VipCushionedChairsActivity"/>
        <activity android:name=".ChairsActivity"/>
        <activity android:name=".BanquetTablesActivity"/>
        <activity android:name=".StagePlatformActivity"/>
        <activity android:name=".DecorationItemsActivity"/>
        <activity android:name=".EventCurtainsActivity"/>
        <activity android:name=".LedLightingSystemActivity"/>
        <activity android:name=".FlowerStandsActivity"/>
        <activity android:name=".BackdropDecorActivity"/>
        <activity android:name=".FloralArchesActivity"/>
        <activity android:name=".HospitalityItemsActivity"/>

        <!-- Notifications -->
        <activity android:name=".SendNotificationActivity"/>
        <activity android:name=".NotificationActivity"/>
    </application>

</manifest>
